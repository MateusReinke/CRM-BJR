# Copy to .env for local development. For Coolify, use the "Docker Compose"
# build pack pointed at docker-compose.yml instead - it already carries
# ready-to-use values for everything but DATABASE_URL. This file is the
# reference for local dev and for any platform that isn't Compose-aware.
# Do not commit a real .env.

# Postgres connection string. Use Coolify's own Postgres resource (or Neon)
# and paste its connection string here. If the host contains "neon.tech",
# server/db.ts automatically uses Neon's serverless driver; any other host
# uses the standard node-postgres driver.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: separate key used to encrypt nota fiscal provider API keys at
# rest (server/utils/crypto.ts). Falls back to SESSION_SECRET if unset -
# set a dedicated value in production.
ENCRYPTION_KEY=change-me-to-another-long-random-string

# Port the app listens on. Coolify maps this automatically if you expose it
# as the container port; 5000 matches this project's default.
PORT=5000

NODE_ENV=production

# Optional: SMTP server used to send "esqueci minha senha" e-mails
# (server/utils/mailer.ts). Without SMTP_HOST set, the reset link is logged
# to the server console instead of e-mailed - fine for local dev, but set
# these before relying on password reset in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=change-me
# SMTP_FROM=BJR Centro Automotivo <no-reply@bjrautomotivo.com.br>
